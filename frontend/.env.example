# =============================================================================
# Arbora Protocol — Frontend Environment Variables (Vite)
# Copy this file to frontend/.env. The contract addresses below are already
# filled with the live Arbitrum Sepolia deployment (see root README).
# NEVER commit frontend/.env to git.
# =============================================================================

# Scoring API (FastAPI backend).
# Empty = Vite dev server proxies /score to localhost:8000.
VITE_API_URL=

# --- Contract addresses (Arbitrum Sepolia, live) ----------------------------
# The app still renders without these: it shows a
# "Contracts not configured" notice and disables
# onchain write actions while scoring/demo panels keep working.

VITE_ATTESTATION_REGISTRY_ADDRESS=0x812a283c68F76E169B1DbdBe23434Bc47f11a897
VITE_CREDIT_ORACLE_ADDRESS=0x93Fb575277eb28f5C0b3987aC233534cF8d11E8A
VITE_LENDING_POOL_ADDRESS=0xf3b1381013f6475b659b9468163ff23935dd3351
VITE_USDG_TOKEN_ADDRESS=0xFFC95faa3d63Cde504a05B567C600B78C0b41892
