# =============================================================================
# Arbora Protocol — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# =============================================================================

# --- Allium ---
# Optional — Allium API key for live blockchain data queries.
# Without this key, the scoring pipeline works in demo mode:
#   - Pre-cached real wallet data for known addresses (from demo_wallets.json)
#   - Deterministic synthetic profiles for unknown addresses
# With this key, the pipeline queries live blockchain data across 5 chains (~90 seconds per score).
# Get a key at https://app.allium.so
ALLIUM_API_KEY=

# --- Arbitrum Sepolia (deployment target) ---
# Generate a fresh wallet for testnet only. NEVER use a mainnet private key.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_PRIVATE_KEY=

# Etherscan V2 API key — one key for every chain (Arbitrum Sepolia, Arbitrum One, Arbiscan)
ETHERSCAN_API_KEY=

# --- USDG (lending asset) ---
# 6-decimal ERC20 the pool holds as liquidity/debt.
# Live pool uses real Paxos USDG on Arbitrum Sepolia (faucet: faucet.paxos.com).
USDG_TOKEN_ADDRESS=0xFFC95faa3d63Cde504a05B567C600B78C0b41892

# --- Deployed contract addresses (Arbitrum Sepolia, live since 2026-09-25) ---
ATTESTATION_REGISTRY_ADDRESS=0x812a283c68F76E169B1DbdBe23434Bc47f11a897
CREDIT_ORACLE_ADDRESS=0x93Fb575277eb28f5C0b3987aC233534cF8d11E8A
# Redeployed 2026-09-26 against real Paxos USDG (script/DeployUsdgPool.s.sol):
LENDING_POOL_ADDRESS=0xf3b1381013f6475b659b9468163ff23935dd3351

# --- Foundry-only (used by script/Deploy.s.sol, not by the backend) ---
# PRIVATE_KEY=
# PRICE_ORACLE_ADDRESS=
# ETH_USD_PRICE_E18=2000000000000000000
